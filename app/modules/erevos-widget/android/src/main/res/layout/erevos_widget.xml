<?xml version="1.0" encoding="utf-8"?>
<!-- Erevos's widget (ErevosWidget.kt): four buttons, each with how many are new over the first three. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/erevos_widget"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/erevos_widget_back"
  android:gravity="center"
  android:orientation="horizontal"
  android:padding="6dp">

  <LinearLayout
    android:id="@+id/erevos_widget_phone"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/erevos_widget_press"
    android:gravity="center"
    android:orientation="vertical">

    <FrameLayout
      android:layout_width="48dp"
      android:layout_height="34dp">

      <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/erevos_widget_phone" />
      <TextView
        android:id="@+id/erevos_widget_phone_count"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:background="@drawable/erevos_widget_badge"
        android:gravity="center"
        android:minWidth="18dp"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
    </FrameLayout>

    <TextView
      android:id="@+id/erevos_widget_phone_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#E9EAF2"
      android:textSize="12sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/erevos_widget_sms"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/erevos_widget_press"
    android:gravity="center"
    android:orientation="vertical">

    <FrameLayout
      android:layout_width="48dp"
      android:layout_height="34dp">

      <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/erevos_widget_sms" />
      <TextView
        android:id="@+id/erevos_widget_sms_count"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:background="@drawable/erevos_widget_badge"
        android:gravity="center"
        android:minWidth="18dp"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
    </FrameLayout>

    <TextView
      android:id="@+id/erevos_widget_sms_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#E9EAF2"
      android:textSize="12sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/erevos_widget_messages"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/erevos_widget_press"
    android:gravity="center"
    android:orientation="vertical">

    <FrameLayout
      android:layout_width="48dp"
      android:layout_height="34dp">

      <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/erevos_widget_messages" />
      <TextView
        android:id="@+id/erevos_widget_messages_count"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:background="@drawable/erevos_widget_badge"
        android:gravity="center"
        android:minWidth="18dp"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
    </FrameLayout>

    <TextView
      android:id="@+id/erevos_widget_messages_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#E9EAF2"
      android:textSize="12sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/erevos_widget_contacts"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/erevos_widget_press"
    android:gravity="center"
    android:orientation="vertical">

    <FrameLayout
      android:layout_width="48dp"
      android:layout_height="34dp">

      <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/erevos_widget_contacts" />
    </FrameLayout>

    <TextView
      android:id="@+id/erevos_widget_contacts_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#E9EAF2"
      android:textSize="12sp" />
  </LinearLayout>
</LinearLayout>
