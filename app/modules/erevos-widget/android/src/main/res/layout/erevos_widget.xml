<!-- Erevos's widget (ErevosWidget.kt): four places, from left to right, each showing one of Phone, SMS,
     Messages and Contacts in the order the owner chose (Appearance → Widget), with how many are new. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/erevos_widget"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/erevos_widget_back"
  android:gravity="center"
  android:orientation="horizontal"
  android:padding="6dp">

  <LinearLayout
    android:id="@+id/erevos_widget_slot0"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/erevos_widget_press"
    android:gravity="center"
    android:orientation="vertical">

    <FrameLayout
      android:layout_width="48dp"
      android:layout_height="34dp">

      <ImageView
        android:id="@+id/erevos_widget_slot0_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no" />
      <TextView
        android:id="@+id/erevos_widget_slot0_count"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:background="@drawable/erevos_widget_badge"
        android:gravity="center"
        android:minWidth="18dp"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
    </FrameLayout>

    <TextView
      android:id="@+id/erevos_widget_slot0_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#E9EAF2"
      android:textSize="12sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/erevos_widget_slot1"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/erevos_widget_press"
    android:gravity="center"
    android:orientation="vertical">

    <FrameLayout
      android:layout_width="48dp"
      android:layout_height="34dp">

      <ImageView
        android:id="@+id/erevos_widget_slot1_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no" />
      <TextView
        android:id="@+id/erevos_widget_slot1_count"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:background="@drawable/erevos_widget_badge"
        android:gravity="center"
        android:minWidth="18dp"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
    </FrameLayout>

    <TextView
      android:id="@+id/erevos_widget_slot1_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#E9EAF2"
      android:textSize="12sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/erevos_widget_slot2"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/erevos_widget_press"
    android:gravity="center"
    android:orientation="vertical">

    <FrameLayout
      android:layout_width="48dp"
      android:layout_height="34dp">

      <ImageView
        android:id="@+id/erevos_widget_slot2_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no" />
      <TextView
        android:id="@+id/erevos_widget_slot2_count"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:background="@drawable/erevos_widget_badge"
        android:gravity="center"
        android:minWidth="18dp"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
    </FrameLayout>

    <TextView
      android:id="@+id/erevos_widget_slot2_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#E9EAF2"
      android:textSize="12sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/erevos_widget_slot3"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/erevos_widget_press"
    android:gravity="center"
    android:orientation="vertical">

    <FrameLayout
      android:layout_width="48dp"
      android:layout_height="34dp">

      <ImageView
        android:id="@+id/erevos_widget_slot3_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no" />
      <TextView
        android:id="@+id/erevos_widget_slot3_count"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:background="@drawable/erevos_widget_badge"
        android:gravity="center"
        android:minWidth="18dp"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
    </FrameLayout>

    <TextView
      android:id="@+id/erevos_widget_slot3_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#E9EAF2"
      android:textSize="12sp" />
  </LinearLayout>
</LinearLayout>
