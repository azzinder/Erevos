{
  "expo": {
    "name": "Erevos",
    "slug": "erevos",
    "version": "0.0.1",
    "scheme": "erevos",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0D0B09",
    "ios": {
      "bundleIdentifier": "app.erevos"
    },
    "android": {
      "package": "app.erevos",
      "adaptiveIcon": {
        "backgroundColor": "#0D0B09"
      }
    },
    "plugins": [
      "expo-router",
      "react-native-quick-crypto",
      [
        "expo-audio",
        {
          "microphonePermission": "Erevos uses the microphone for voice messages, only while you hold Voice."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
