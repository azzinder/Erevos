{
  "expo": {
    "name": "Erevos",
    "slug": "erevos",
    "version": "0.0.1",
    "scheme": "erevos",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0D0B09",
    "icon": "./assets/icon/icon.png",
    "ios": {
      "bundleIdentifier": "app.erevos",
      "infoPlist": {
        "NSCameraUsageDescription": "Erevos uses the camera only during a video call you make or answer."
      }
    },
    "android": {
      "package": "app.erevos",
      "icon": "./assets/icon/android-square.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/android-adaptive-foreground.png",
        "backgroundImage": "./assets/icon/android-adaptive-background.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "erevos-web.lphl.nekten.eu",
              "path": "/i"
            },
            {
              "scheme": "https",
              "host": "erevos-web.lphl.nekten.eu",
              "path": "/i/"
            },
            {
              "scheme": "https",
              "host": "erevos-web.lphl.nekten.eu",
              "path": "/c"
            },
            {
              "scheme": "https",
              "host": "erevos-web.lphl.nekten.eu",
              "path": "/c/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/icon/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": { "web": false }
        }
      ],
      "react-native-quick-crypto",
      [
        "expo-audio",
        {
          "microphonePermission": "Erevos uses the microphone for voice messages, only while you hold the microphone button, and during calls."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Erevos uses the camera only while its own camera is open in the Collection, or when you tap Camera or Take photo.",
          "microphonePermission": "Erevos uses the microphone for a video's sound only while its own camera records.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Erevos opens your photos only when you choose one to send.",
          "cameraPermission": "Erevos uses the camera only when you tap Camera or Take photo.",
          "microphonePermission": "Erevos uses the microphone for voice messages, only while you hold the microphone button."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
