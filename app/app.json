{
  "expo": {
    "name": "Erevos",
    "slug": "erevos",
    "version": "0.0.1",
    "scheme": "erevos",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0D0B09",
    "ios": {
      "bundleIdentifier": "app.erevos"
    },
    "android": {
      "package": "app.erevos",
      "adaptiveIcon": {
        "backgroundColor": "#0D0B09"
      }
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
